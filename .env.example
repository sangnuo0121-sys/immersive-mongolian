# ============================================
# Supabase 配置 - 请填入你自己的 Supabase 项目凭证
# ============================================
# 
# 获取方式：
# 1. 登录 https://supabase.com/dashboard
# 2. 选择你的项目
# 3. 点击 Settings > API
# 4. 复制 Project URL 和 anon public API key
#

# 你的 Supabase 项目 URL（必填）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 你的 Supabase Anon Key（必填，公开安全）
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 你的 Supabase Service Role Key（仅服务端使用，勿泄露）
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# 首位管理员（仅服务端读取；请使用真实部署平台的 Secret 管理功能）
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# ============================================
# Storage Bucket 配置
# ============================================
# 在 Supabase Dashboard > Storage > New Bucket 创建以下 buckets：
# 1. audio-records - 用于存储录音文件
# 2. acknowledgements-images - 用于存储鸣谢页面图片
#
# 权限设置：
# - Public 仅表示文件可读取
# - 上传、更新和删除权限由 supabase/migrations/0002_secure_content_rls.sql 控制

# ============================================
# 反馈系统 - 维护者密码
# ============================================
# 用于标记公开反馈为"已解决"的密码
# 请使用足够强度的密码，不要使用常见密码
FEEDBACK_RESOLVE_CODE=your-secret-code-here
